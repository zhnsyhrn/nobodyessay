{
  "_meta": {
    "name": "byzahin.com Chatbot Knowledge Base",
    "version": "1.0.0",
    "description": "Keyword/intent-matching database for a client-side FAQ chatbot. Edit the 'answer' fields freely — the 'keywords' arrays are what the matcher scores against. Keep keywords lowercase.",
    "audience": [
      "recruiters_hiring_managers",
      "freelance_clients"
    ],
    "how_to_edit": "Each object in 'intents' is one topic. 'keywords' = words/phrases that trigger it. 'examples' = sample real questions (for your reference + can double as training phrases). 'answer' = what the bot replies. 'quickReplies' = optional buttons shown after the answer to guide the next question. 'links' = optional URLs the bot can surface."
  },
  "settings": {
    "matchThreshold": 0.35,
    "maxQuickReplies": 4,
    "caseSensitive": false,
    "fallbackIntentId": "fallback"
  },
